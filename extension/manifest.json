{
  "manifest_version": 3,
  "name": "PasteFlick",
  "version": "1.0.50",
  "description": "Copy a ChatGPT highlight or visible thread, then flick it into the last app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PasteFlick",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage", "downloads", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.chatgpt.com/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": ["pasteflick.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": ["extractor.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "icons/*", "install-info.json"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chatgpt.com/*"
      ]
    }
  ]
}
